{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/RVanDamme/muffin/master/assets/schema_input.json",
    "title": "RVanDamme/muffin pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": [
                    "id"
                ]
            },
            "short_reads_1": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
                "errorMessage": "Short reads R1 file cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'"
            },
            "short_reads_2": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
                "errorMessage": "Short reads R2 file cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'"
            },
            "long_reads": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
                "errorMessage": "Long (ONT) reads file cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'"
            },
            "rna_reads_1": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
                "errorMessage": "RNA reads R1 file cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'"
            },
            "rna_reads_2": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^([\\S\\s]*\\/)?[^\\s\\/]+\\.f(ast)?q\\.gz$",
                "errorMessage": "RNA reads R2 file cannot contain spaces and must have extension '.fq.gz' or '.fastq.gz'"
            }
        },
        "required": [
            "sample"
        ],
        "dependentRequired": {
            "short_reads_1": [
                "short_reads_2"
            ],
            "short_reads_2": [
                "short_reads_1"
            ],
            "rna_reads_1": [
                "rna_reads_2"
            ],
            "rna_reads_2": [
                "rna_reads_1"
            ]
        },
        "anyOf": [
            {
                "required": [
                    "short_reads_1"
                ]
            },
            {
                "required": [
                    "long_reads"
                ]
            }
        ],
        "errorMessage": {
            "anyOf": "Each sample needs a short-read pair (short_reads_1 and short_reads_2), long reads (long_reads), or both",
            "dependentRequired": "Read pairs must be complete: give both _1 and _2 files"
        }
    },
    "uniqueEntries": [
        "sample"
    ]
}
