/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // Read QC
    //
    withName: 'CHOPPER' {
        // args/args3 are the pigz steps of the module; chopper's own options are args2
        ext.args2 = { "-q ${params.longread_min_quality} -l ${params.longread_min_length} --headcrop 100" }
    }

    withName: '.*:TRANSCRIPTOMICS:FASTP' {
        ext.prefix = { "${meta.id}_rna" }
    }

    //
    // Assembly and long-read polishing
    //
    withName: 'SPADES' {
        ext.args = '--meta'
    }

    withName: 'FLYE' {
        ext.args = '--meta'
    }

    withName: '.*:LONGREAD_POLISH:MINIMAP2_ALIGN.*' {
        // PAF output for racon (bam_format = false)
        ext.args = '-x map-ont --split-prefix tmp_idx'
    }

    withName: 'MEDAKA' {
        // no -m: medaka selects the model from the read headers
        ext.args = { params.medaka_model ? "-m ${params.medaka_model}" : '' }
    }

    //
    // Read mapping (module adds -a and sorts when bam_format = true)
    //
    withName: '.*:(READ_MAPPING|UNBINNED_READ_CLASSIFICATION):MINIMAP2_ALIGN.*' {
        ext.args = '-x map-ont --split-prefix tmp_idx'
    }

    //
    // Binning
    //
    withName: 'SEMIBIN_SINGLEEASYBIN' {
        // options of the single_easy_bin subcommand go after it: args2
        ext.args2 = { params.semibin_mode == 'self' ? '--self-supervised' : "--environment ${params.semibin_environment}" }
    }

    withName: 'COMEBIN_RUNCOMEBIN' {
        // meta.n50 is set in BINNING from SEQKIT_STATS
        ext.args = { "-l ${meta.n50 > 10000 ? 0.07 : 0.15}" }
    }

    //
    // Bin quality control
    //
    withName: 'CHECKM2_PREDICT' {
        ext.args = { params.checkm2_lowmem ? '--lowmem' : '' }
    }

    //
    // Taxonomic classification
    //
    withName: '.*:UNBINNED_READ_CLASSIFICATION:SAMTOOLS_FASTQ' {
        // unmapped reads only
        ext.args = '-f 4'
    }

    withName: '.*:UNBINNED_READ_CLASSIFICATION:SOURMASH_SKETCH_SHORT' {
        ext.args = "dna -p k=31,scaled=10000"
    }

    withName: '.*:UNBINNED_READ_CLASSIFICATION:SOURMASH_SKETCH_LONG' {
        ext.args = "dna -p k=31,scaled=5000"
    }

    withName: '.*:BIN_TAXONOMY:SOURMASH_SKETCH' {
        ext.args = "dna -p k=31,scaled=10000"
    }

    withName: 'SOURMASH_GATHER' {
        ext.args = '-k 31'
    }

    withName: 'GTDBTK_CLASSIFYWF' {
        // bins arrive gzipped from the binners; Stage 4 must gzip Pilon output and --input_bins files before this step
        ext.args = '--extension gz'
    }

    //
    // Functional annotation
    //
    withName: '.*:BIN_ANNOTATION:EGGNOGMAPPER' {
        ext.args = '--itype metagenome --translate --go_evidence non-electronic --target_orthologs all'
    }

    withName: '.*:TRANSCRIPTOMICS:EGGNOGMAPPER' {
        ext.args = '--itype CDS --translate --go_evidence non-electronic --target_orthologs all'
    }

    //
    // Metatranscriptomics
    //
    withName: 'SALMON_QUANT' {
        // the gene map input is the transcript-to-gene table built in TRANSCRIPTOMICS from the Trinity IDs
        ext.args = '--libType A'
    }

}
