/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for HPC2N Kebnekaise (Slurm + Apptainer)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:
        export SBATCH_ACCOUNT=hpc2nXXXX-YYY      # your compute project
        export NXF_APPTAINER_CACHEDIR=/proj/nobackup/<storage-project>/apptainer_cache
        nextflow run . -profile hpc2n --input samplesheet.csv --outdir <OUTDIR>
    See docs/hpc2n.md.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'HPC2N Kebnekaise'
    config_profile_description = 'Slurm executor with Apptainer on Kebnekaise (HPC2N, Umeå University)'
    config_profile_url         = 'https://docs.hpc2n.umu.se/'
}

apptainer {
    enabled    = true
    autoMounts = true
}

executor {
    name            = 'slurm'
    queueSize       = 50
    submitRateLimit = '10/1min'
    pollInterval    = '30 sec'
}

process {
    // The compute project is taken by Slurm from the SBATCH_ACCOUNT environment variable.
    // Limits of a regular Skylake compute node (2 x 14 cores, 192 GB) and the 168 h walltime cap.
    resourceLimits = [
        cpus: 28,
        memory: 180.GB,
        time: 168.h
    ]
}
